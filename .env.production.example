APP_NAME="Estúdio Norra"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://estudionorra.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Configuração SQLite padrão (zero latência na Hostinger)
DB_CONNECTION=sqlite
# Se preferir MySQL da Hostinger, descomente abaixo:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u123456789_norra
# DB_USERNAME=u123456789_norra
# DB_PASSWORD=seu_password_aqui

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

# E-mail de Produção (SMTP da Hostinger / Titan Mail)
MAIL_MAILER=smtp
MAIL_HOST=smtp.titan.email
MAIL_PORT=465
MAIL_USERNAME=contato@estudionorra.com
MAIL_PASSWORD=sua_senha_do_email
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contato@estudionorra.com"
MAIL_FROM_NAME="Estúdio Norra"
NORRA_NOTIFY_EMAIL="contato@estudionorra.com"
