# ==============================================================================
# Estúdio Norra - Root Web Server Hardening & Safe Redirect (.htaccess)
# ==============================================================================

# Disable Directory Browsing
Options -Indexes -MultiViews

# Block all access to hidden files and directories (e.g. .env, .git, .editorconfig)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to sensitive files and extensions
<FilesMatch "(?i)\.(env|sqlite|sqlite3|db|log|lock|sql|bak|sh|yml|yaml|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct HTTP access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(\/.*)?$ - [F,L]

    # Block any hidden file or folder path
    RewriteRule (^\.|/\.) - [F,L]

    # If domain points to root directory, route traffic safely to /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L,QSA]
</IfModule>
